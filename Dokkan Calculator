\"boolean\"}\n","damage_reduction = 0.30 #@param {type:\"number\"}\n","\n","#@markdown ### Enemy Debuffs on Player\n","hp_reduction_percent = 0 #@param {type:\"number\"}\n","def_reduction_percent = 0 #@param {type:\"number\"}\n","\n","# --- Calculations ---\n","# Calculate Enemy Super\n","enemy_super = (base_super + (base_super * number_actions * action_multiplier)) * (1 + attack_multiplier)\n","\n","# Calculate player defense\n","final_defense_before_debuff = sot_defense * (1 + (supers_this_turn * super_boost_per_stack))\n","final_defense = final_defense_before_debuff * (1 - def_reduction_percent)\n","\n","# Calculate player start of turn HP after SOT debuff\n","starting_hp = max_hp * (1 - hp_reduction_percent)\n","\n","# Guard modifier (A critical hit bypasses guard entirely, treating it as 1.0)\n","guard_multiplier = 0.5 if (has_guard and not enemy_crit) else 1.0\n","\n","# Dokkan Damage Formula: (Enemy_ATK * (1 - DR) * Guard) - DEF\n","# Note: A critical hit bypasses both Guard and Defense completely, applying only DR to the enemy attack.\n","if enemy_crit:\n","    damage_taken = max(0, enemy_super * (1 - damage_reduction))\n","else:\n","    reduced_enemy_super = enemy_super * (1 - damage_reduction) * guard_multiplier\n","    damage_taken = max(0, reduced_enemy_super - final_defense)\n","\n","# Check Survival\n","remaining_hp = starting_hp - damage_taken\n","survived = remaining_hp > 0\n","\n","# --- Output Display ---\n","print(f\"Enemy Super Attack:    {int(enemy_super):,}\")\n","if enemy_crit:\n","    print(\"Enemy landed a CRITICAL HIT! (Bypasses Defense and Guard)\")\n","print(f\"Defense before Super:  {int(sot_defense):,}\")\n","print(f\"Defense after Super:   {int(final_defense_before_debuff):,}\")\n","print(f\"Defense after Debuff:  {int(final_defense):,}\")\n","print(f\"Damage Taken:          {int(damage_taken):,}\")\n","print(\"-\" * 40)\n","print(f\"Max HP:                {max_hp:,}\")\n","print(f\"HP after SOT Debuff:   {int(starting_hp):,}\")\n","if survived:\n","    print(f\"Status:                SURVIVED!\")\n","    print(f\"Remaining HP:          {int(remaining_hp):,} ({remaining_hp/max_hp*100:.1f}% of Max HP left)\")\n","else:\n","    print(f\"Status:                DEAD...\")\n","    print(f\"Over-killed by:        {abs(int(remaining_hp)):,}\")"],"execution_count":63,"outputs":[{"output_type":"stream","name":"stdout","text":["Enemy Super Attack:    22,750,000\n","Defense before Super:  17,970,780\n","Defense after Super:   28,753,248\n","Defense after Debuff:  28,753,248\n","Damage Taken:          0\n","----------------------------------------\n","Max HP:                987,069\n","HP after SOT Debuff:   987,069\n","Status:                SURVIVED!\n","Remaining HP:          987,069 (100.0% of Max HP left)\n"]}]}]}